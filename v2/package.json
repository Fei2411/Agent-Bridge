{
  "name": "@agent-bridge/hub",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "One local Hub for Agent Bridge sessions, tasks and peer communication",
  "license": "MIT",
  "type": "module",
  "bin": { "agent-bridge-hub": "dist/cli.js" },
  "files": ["dist/**/*.js", "agents.toml", "README.md", "ARCHITECTURE.zh-CN.md", "MIGRATION.md", "LICENSE"],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke:package": "node test/package-smoke.mjs",
    "smoke:opencode": "npm run build && node --test test/opencode-smoke.mjs",
    "prepack": "npm run build",
    "start": "node dist/cli.js hub",
    "mcp": "node dist/cli.js mcp"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cross-spawn": "^7.0.6",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
